# ChustApp server sozlamalari — namuna.
# Nusxa oling: copy .env.example .env  va qiymatlarni to'ldiring.
# .env fayli git'ga qo'shilmaydi!

DATABASE_URL=postgres://chust:PAROL@localhost:5432/chustapp
JWT_SECRET=kamida_32_belgili_tasodifiy_qator
GOOGLE_MAPS_API_KEY=Google_Cloud_Console_dan_olingan_kalit
# Geokodlash VA dispatch (Distance Matrix — kuryer ETA'si) uchun ALOHIDA
# kalit (referrer-cheklangan kalit bilan ISHLAMAYDI — bu API'lar buni rad
# etadi). Console'da 2-chi kalit: Application restrictions "None"/server IP,
# API restrictions: "Geocoding API" + "Places API" + "Distance Matrix API".
GOOGLE_GEOCODING_API_KEY=
# Ixtiyoriy ikkinchi manba — yandex.com/maps-api/products/geocoder-api, bepul, kartasiz
YANDEX_GEOCODER_API_KEY=
# Ixtiyoriy uchinchi manba — dev.2gis.ru/api. DIQQAT: demo kalit yaratilgan
# kundan 1 OYGA amal qiladi (doimiy bepul emas), keyin obuna kerak.
DGIS_API_KEY=

# Katalog (restoranlar+menyu) — MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=chustapp

# Redis — ixtiyoriy: restoranlar/menyu keshlash + OTP kodlar. Bo'sh
# qoldirilsa (yoki Redis ulanmasa) kesh o'chirilgan holda ishlayveradi,
# OTP kodlar asosiy bazada (Postgres/xotira) qolaveradi.
# DIQQAT: 6379 emas, 6380 — agar kompyuteringizda 6379-portda BOSHQA Redis
# (masalan eski Windows xizmati) ishlab tursa, docker-compose'dagi
# konteyner bilan to'qnashib qolmasligi uchun.
REDIS_ADDR=localhost:6380

# Mahsulot rasmlari — Cloudflare R2 (bo'sh qoldirilsa lokal diskka yoziladi)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# WebSocket VA REST CORS — vergul bilan ajratilgan ruxsat etilgan brauzer
# origin'lari (masalan https://admin.chustapp.uz,https://app.chustapp.uz).
#
# PRODUCTION rejimda (ya'ni APP_ENV=development BO'LMAGANDA) bu MAJBURIY:
# bo'sh bo'lsa server ishga tushmaydi va xato bilan to'xtaydi. Bu ataylab:
# avval bo'sh qiymat "hamma origin'ga ruxsat" degani edi, ya'ni sozlashni
# unutish jimgina butun himoyani o'chirib qo'yardi. Dev rejimda bo'sh
# qoldirish mumkin (native mobil ilovalarga ta'sir qilmaydi — ular Origin
# header umuman yubormaydi).
ALLOWED_ORIGINS=

# Tezlik cheklovi (SMS byudjeti, brute-force, pullik geokodlash) mijoz IP'siga
# tayanadi. `X-Forwarded-For` sarlavhasi FAQAT shu ro'yxatdagi manbalardan
# qabul qilinadi — bo'sh bo'lsa u umuman o'qilmaydi va har doim haqiqiy
# ulanish manzili ishlatiladi.
#
# NEGA SHUNDAY: avval sarlavhaga shartsiz ishonilardi, ya'ni istalgan mijoz
# uni o'zi yozib, har so'rovda yangi "IP" ko'rsatib, BARCHA IP cheklovlarini
# chetlab o'tardi (o'lchov: soxta sarlavha bilan 60/60 so'rov o'tdi, sarlavhasiz
# 32-so'rovda 429 keldi).
#
# To'g'ridan-to'g'ri (proksisiz) ishlaganda BO'SH qoldiring. Reverse-proxy
# (Caddy/nginx) orqasiga qo'yilganda o'sha proksining manzilini yozing, aks
# holda hamma so'rov bitta IP'dan kelgandek ko'rinib, cheklov barcha
# foydalanuvchini birga bloklab qo'yadi. Vergul bilan; CIDR yoki yakka IP.
# Masalan: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# ---------- Email (tasdiqlash kodlari) ----------
#
# SMTP_HOST bo'sh bo'lsa: email oqimlari (email bilan ro'yxatdan o'tish,
# email orqali parolni tiklash) ISHLAMAYDI va foydalanuvchiga aniq xabar
# beriladi. Dev rejimda (APP_ENV=development) kod logga yoziladi va
# javobda `dev_code` sifatida qaytadi — SMTP'siz ham sinash mumkin.
#
# Gmail bilan: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=sizning@gmail.com, SMTP_PASSWORD=<APP PASSWORD>.
# ODDIY Gmail PAROLI ISHLAMAYDI — Google hisobida 2FA yoqilgan bo'lishi
# va "App password" (16 belgili) yaratilgan bo'lishi kerak.
# Kundalik limit ~500 xat; ko'proq kerak bo'lsa SendGrid/Mailgun/Resend.
#
# Ulanish HAR DOIM shifrlanadi: 465 — bevosita TLS, boshqa portlar
# (587) — STARTTLS. Server STARTTLS'ni qo'llab-quvvatlamasa yuborish
# TO'XTATILADI (parol ochiq ketmasligi uchun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Kimdan ko'rinadi (bo'sh bo'lsa SMTP_USERNAME ishlatiladi).
SMTP_FROM=
SMTP_FROM_NAME=OnDex

# ---------- Firebase Phone Auth (telefon SMS kodi) ----------
#
# SMS kodni FIREBASE yuboradi va tekshiradi — biz kod yubormaymiz ham,
# tekshirmaymiz ham. Ilova Firebase'dan ID token oladi va uni
# `POST /auth/firebase` ga yuboradi; backend tokenning IMZOSINI
# tekshirib, telefon raqamini TOKEN ICHIDAN oladi.
#
# MAXFIY KALIT KERAK EMAS. Tekshiruv Google'ning OCHIQ sertifikatlari
# bilan bajariladi, shuning uchun bu yerda faqat loyiha identifikatori
# turadi. (Firebase Admin SDK xizmat akkaunti kalitini talab qilardi —
# u butun loyihaga to'liq huquq beruvchi maxfiy fayl; bizga kerak emas.)
#
# Bo'sh bo'lsa `/auth/firebase` 503 qaytaradi (integratsiya o'chiq).
#
# Qiymatni Firebase Console -> Project settings -> "Project ID" dan
# oling (masalan `ondex-12ab3`).
FIREBASE_PROJECT_ID=

# ---------- OTP yetkazish zanjiri ----------
#
# Uch pog'ona. Har biri MUSTAQIL sozlanadi — biri bo'lmasa ilova
# keyingisiga o'tadi:
#
#   1. Telegram bot  (bepul)   TELEGRAM_BOT_TOKEN
#   2. Firebase SMS  (pullik)  FIREBASE_PROJECT_ID (yuqorida)
#   3. Eskiz.uz SMS  (so'mda)  ESKIZ_EMAIL / ESKIZ_PASSWORD
#
# Uchalasi ham oxirida BIR XIL yo'lga tushadi: kod odatdagi kod
# do'koniga yoziladi va `POST /auth/verify` bilan tekshiriladi
# (Firebase bundan mustasno — u o'z ID tokenini beradi).

# --- 1) Telegram bot ---
#
# @BotFather ga `/newbot` yozib olinadi. Bot OMMAVIY HTTPS manzil
# TALAB QILMAYDI — long polling ishlatiladi, ya'ni lokal serverda ham
# ishlaydi.
#
# XAVFSIZLIK: bot kodni yuborishdan OLDIN foydalanuvchidan "Raqamni
# ulashish" tugmasini bosishni so'raydi va Telegram tasdiqlagan raqamni
# ilovada kiritilgan raqam bilan solishtiradi. Mos kelmasa kod
# YUBORILMAYDI — busiz begona odam sizning raqamingizni yozib, botni
# o'zining Telegramida ochib, kodni olib ketardi.
TELEGRAM_BOT_TOKEN=

# PUBLIC_BASE_URL — serverning TASHQARIDAN ko'rinadigan manzili.
#
# "Telegram bilan kirish" oqimida bot oxirida "OnDex'ga qaytish"
# tugmasini yuboradi. Tugma shu manzildagi `/auth/telegram/return`
# ga ishora qiladi, server esa uni `ondex://auth?c=...` ga yo'naltiradi
# va ilova kirishni yakunlaydi.
#
# NEGA TO'G'RIDAN-TO'G'RI `ondex://` EMAS: Telegram inline tugmada
# FAQAT http(s):// va tg:// havolalarini qabul qiladi, boshqa sxemani
# `BUTTON_URL_INVALID` bilan rad etadi.
#
# TELEFON BRAUZERI bu manzilga chiqa olishi SHART:
#   * USB + `adb reverse tcp:8080 tcp:8080` -> http://localhost:8080
#   * bir xil Wi-Fi                          -> http://192.168.X.X:8080
#   * production                             -> https://api.ondex.uz
#
# Bo'sh qoldirilsa: dev rejimda http://localhost:8080 ishlatiladi,
# production'da esa Telegram bilan kirish YAKUNLANMAYDI (server bu
# haqda ERROR yozadi).
PUBLIC_BASE_URL=

# EMAIL_LOGIN_ENABLED — email orqali KIRISH/RO'YXATDAN O'TISH.
#
# Standart: O'CHIQ (bo'sh = false). Mijoz ilovasida bu yo'l olib
# tashlangan — email bilan ochilgan akkauntda telefon bo'sh qoladi va
# kuryer mijozga qo'ng'iroq qila olmaydi (ROADMAP 62-band).
#
# O'chiq bo'lganda quyidagilar 404 qaytaradi:
#   POST /auth/email/request-code
#   POST /auth/email/verify
#   POST /auth/register   (FAQAT email rejimi; telefon rejimi ishlaydi)
#
# DIQQAT: bu SMTP'ni o'chirmaydi. Chek, buyurtma tasdiqnomasi va
# boshqa bildirishnomalar yuborilishda davom etadi — faqat email
# KIMLIK sifatida ishlatilmaydi.
#
# Xodim (restoran/kuryer/admin) panellari uchun kerak bo'lsa: true
EMAIL_LOGIN_ENABLED=

# ARGON_MAX_CONCURRENCY — bir vaqtda bajariladigan parol tekshiruvlari.
#
# Argon2id har chaqiruvda 64 MB xotira oladi. Bu brute-force'ga qarshi
# ataylab qimmat, LEKIN cheklovsiz qoldirilsa hujumchi uni SERVERGA
# qarshi ishlatadi: 50 parallel /auth/login = 50 × 64 MB = 3.2 GB -> OOM.
#
# XOTIRA HISOBI:  eng ko'p xotira ≈ ARGON_MAX_CONCURRENCY × 64 MB
#
# Bo'sh qoldirilsa: yadrolar soni / 2 (kamida 2, ko'pi bilan 8).
#   2 yadroli VPS  -> 2 -> 128 MB
#   12 yadroli host -> 6 -> 384 MB
#
# DIQQAT: CPU soni RAM hajmini BILDIRMAYDI. 1-2 GB xotirali serverda
# buni qo'lda 2 ga tushiring. Navbat to'lganda so'rov 503 + Retry-After
# oladi (xato emas, vaqtinchalik holat).
ARGON_MAX_CONCURRENCY=

# FCM push uchun xizmat akkaunti — IKKI YO'LDAN BIRI.
#
# Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key" -> JSON fayl yuklab olinadi.
#
# ── 1-YO'L (TAVSIYA): fayl yo'li ───────────────────────────────────
# Yuklab olingan faylni `secrets/` papkasiga qo'ying (u .gitignore'da):
#
#   FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/fcm.json
#
# Bu yo'l afzal, chunki JSON o'z holicha qoladi.
#
# ── 2-YO'L: to'g'ridan-to'g'ri .env ichida ─────────────────────────
# Bu holda JSON BITTA QATORGA siqilgan bo'lishi SHART. `.env` fayli
# qatorma-qator o'qiladi: ko'p qatorli JSON qo'yilsa faqat birinchi
# qatori olinadi va xato "kalit PEM formatida emas" bo'lib chiqadi.
#
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Ikkalasi ham berilsa INLINE ustun turadi.
FIREBASE_SERVICE_ACCOUNT_FILE=
#
# NEGA KERAK: WebSocket faqat ilova OCHIQ bo'lganda ishlaydi. Ilova
# yopiq bo'lsa foydalanuvchi buyurtma holatini, kuryer esa taklifni
# umuman bilmaydi. Push shu bo'shliqni yopadi.
#
# Bo'sh qoldirilsa: push yuborilmaydi, qolgan hammasi (WebSocket +
# bildirishnomalar tarixi) ishlashda davom etadi. Server ishga
# tushishda ogohlantirish yozadi.
#
# DIQQAT: bu kalit BUTUN Firebase loyihasiga huquq beradi — uni
# repozitoriyga qo'ymang.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- 3) Eskiz.uz (mahalliy SMS provayderi) ---
#
# Bo'sh bo'lsa SMS kodlar faqat logga yoziladi (dev rejim).
# `ESKIZ_FROM` — jo'natuvchi nomi; standart `4546` (Eskiz'ning sinov
# raqami). Haqiqiy nom ("OnDex") operatorlarda alohida ro'yxatdan
# o'tkaziladi va tasdiqlangach shu yerga yoziladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# apps/web (Next.js) — mijoz mini-app'lari (WebView/sayt/Telegram) BFF'i shu
# manzil orqali Go API'ga server-to-server so'rov yuboradi (docker ichida
# host.docker.internal, production'da API'ning haqiqiy ichki manzili).
GO_API_URL=http://host.docker.internal:8080

# Rejim. Dev rejim ATAYLAB opt-in: FAQAT aynan "development" qiymati uni
# yoqadi. Boshqa har qanday qiymat (jumladan bo'sh, yozuv xatosi bilan
# "dev", "Development") — PRODUCTION rejim, ya'ni:
#   * JWT_SECRET majburiy va kamida 32 belgi bo'lishi shart;
#   * ALLOWED_ORIGINS majburiy;
#   * xato javoblarida ichki tafsilotlar ko'rsatilmaydi.
# Avval buning teskarisi edi (noma'lum qiymat = dev), ya'ni yozuv xatosi
# himoyani jimgina o'chirib qo'yardi.
#
# Lokal ishlab chiqish uchun:
# APP_ENV=development
