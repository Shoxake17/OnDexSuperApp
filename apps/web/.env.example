# Go API'ga server-to-server (BFF proksi) manzili. Docker Desktop'da
# host.docker.internal orqali host mashinaga chiqiladi (Go API hozircha
# konteynerlanmagan, to'g'ridan-to'g'ri hostda ishlaydi). Production'da
# Go API'ning haqiqiy ichki manziliga o'zgartiriladi.
GO_API_URL=http://host.docker.internal:8080

# Brauzer/WebView WebSocket ulanishi uchun OMMAVIY manzil (bu browser'da
# ishlaydi, shuning uchun NEXT_PUBLIC_ prefiksi kerak — Next.js buni
# client bundle'ga qo'shadi).
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Rasmlar (mahsulot/restoran) uchun OMMAVIY Go API manzili — brauzer
# to'g'ridan-to'g'ri shu manzildan <img> yuklaydi (R2 rejimida buning
# ahamiyati yo'q, chunki rasm URL'i allaqachon mutlaq bo'ladi).
NEXT_PUBLIC_API_URL=http://localhost:8080

# sitemap.xml/robots.txt uchun to'liq sayt manzili (production'da haqiqiy
# domenga o'zgartiriladi).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
